@model BookingData.Models.Ticket
@{
    ViewData["Title"] = "Новий квиток";
}

<div class="card shadow-sm border-0" style="max-width:600px">
    <div class="card-header bg-success text-white"><h5 class="mb-0">+ Новий квиток</h5></div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="BuyerName" class="form-label fw-semibold"></label>
                <input asp-for="BuyerName" class="form-control" />
                <span asp-validation-for="BuyerName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="BuyerEmail" class="form-label fw-semibold"></label>
                <input asp-for="BuyerEmail" class="form-control" />
                <span asp-validation-for="BuyerEmail" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SeatCount" class="form-label fw-semibold"></label>
                <input asp-for="SeatCount" type="number" min="1" max="20" class="form-control" />
                <span asp-validation-for="SeatCount" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Подія</label>
                <select asp-for="EventId" asp-items="ViewBag.EventsList" class="form-select">
                    <option value="">— Оберіть подію —</option>
                </select>
                <span asp-validation-for="EventId" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">💾 Зберегти</button>
                <a asp-action="Index" class="btn btn-secondary">← Скасувати</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
