@model BookingData.Models.Event

<div class="card mb-3 shadow-sm border-0">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h5 class="card-title mb-1">@Model.Title</h5>
                <small class="text-muted">
                    📍 @Model.Location &nbsp;|&nbsp; 📅 @Model.Date.ToString("dd.MM.yyyy HH:mm")
                </small>
                <p class="card-text mt-2 text-secondary">@Model.Description</p>
            </div>
            <div class="text-end ms-3">
                <span class="fs-5 fw-bold text-success">@Model.Price.ToString("c")</span>
            </div>
        </div>
        <div class="mt-2">
            <a class="btn btn-sm btn-primary" href="/Cart/Add?eventId=@Model.EventId">
                🛒 Додати в кошик
            </a>
        </div>
    </div>
</div>
