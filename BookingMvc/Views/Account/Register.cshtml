@model BookingMvc.Models.ViewModels.RegisterModel
@{
    ViewData["Title"] = "Реєстрація";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow border-0">
            <div class="card-header bg-success text-white text-center py-3">
                <h4 class="mb-0">📝 Реєстрація</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="email@example.com" autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Мінімум 8 символів, літери та цифри" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                        <div class="form-text">Не менше 8 символів, містить цифри та літери (хоча б одна велика)</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Повторіть пароль" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Role" class="form-label fw-semibold"></label>
                        <select asp-for="Role" class="form-select">
                            <option value="User">👤 Звичайний користувач</option>
                            <option value="Admin">🛡 Адміністратор</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2">Зареєструватись</button>
                </form>
            </div>
            <div class="card-footer text-center text-muted py-3">
                Вже є акаунт?
                <a asp-action="Login" class="text-decoration-none fw-semibold">Увійти</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
