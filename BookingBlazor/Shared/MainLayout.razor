@inherits LayoutComponentBase
@inject AuthService AuthSvc
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized Context="mainContext">

        <nav class="navbar navbar-expand-md navbar-dark bg-dark px-3 mb-3">
            <a class="navbar-brand fw-bold" href="/">🎟 Booking Tickets</a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav me-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/">🏠 Головна</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/events">🗓 Події</a>
                    </li>

                    <AuthorizeView Roles="Admin">
                        <Authorized Context="adminContext">

                            <li class="nav-item">
                                <a class="nav-link" href="/admin/events">
                                    ⚙ Адмін: події
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/admin/tickets">
                                    🎫 Адмін: квитки
                                </a>
                            </li>

                        </Authorized>
                    </AuthorizeView>

                </ul>

                <ul class="navbar-nav">

                    <li class="nav-item">
                        <span class="nav-link text-light">

                            👤 @mainContext.User.Identity!.Name

                            @if (mainContext.User.IsInRole("Admin"))
                            {
                            <span class="badge bg-warning text-dark ms-1">
                                    Admin
                                </span>
                            }
                            else
                            {
                            <span class="badge bg-info text-dark ms-1">
                                    User
                                </span>
                            }

                        </span>
                    </li>

                    <li class="nav-item">
                        <button class="btn btn-link nav-link"
                                @onclick="Logout">
                            🚪 Вийти
                        </button>
                    </li>

                </ul>

            </div>
        </nav>

    </Authorized>

    <NotAuthorized>

        <nav class="navbar navbar-dark bg-dark px-3 mb-3">

            <a class="navbar-brand fw-bold" href="/">
                🎟 Booking Tickets
            </a>

            <div class="ms-auto d-flex gap-2">

                <a class="btn btn-outline-light btn-sm"
                   href="/login">
                    🔑 Увійти
                </a>

                <a class="btn btn-success btn-sm"
                   href="/register">
                    📝 Реєстрація
                </a>

            </div>

        </nav>

    </NotAuthorized>
</AuthorizeView>

<div class="container-fluid px-4">

    @if (!string.IsNullOrEmpty(errorMessage))
    {
    <div class="alert alert-danger alert-dismissible">

        @errorMessage

        <button class="btn-close"
                @onclick="() => errorMessage = string.Empty">
        </button>

    </div>
    }

    @Body

</div>

<footer class="bg-light text-center mt-5 p-3 border-top text-muted">
    © 2026 Booking Tickets (Blazor WASM)
</footer>

@code {

private string errorMessage = string.Empty;

private async Task Logout()
{
await AuthSvc.LogoutAsync();

Nav.NavigateTo("/login", forceLoad: true);
}

}